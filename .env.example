APP_NAME="Extremis News"

# ---------------------------------------------------------------------------
# Production defaults. Copy to .env and fill in the secrets.
# Never commit the real .env.
# ---------------------------------------------------------------------------
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://extremis.top

# Set this to the same host as APP_URL so generated links never fall back to
# a dev host.
ASSET_URL="${APP_URL}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once HTTPS is confirmed working on the live domain.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---------------------------------------------------------------------------
# Mail - use a real mailbox on your own domain. AdSense reviewers and users
# both check this. Do not ship hello@example.com.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="contact@extremis.top"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Google AdSense
# ---------------------------------------------------------------------------
ADSENSE_PUBLISHER_ID=pub-7830531573570855

# ---------------------------------------------------------------------------
# IndexNow (Bing / Yandex instant indexing)
# ---------------------------------------------------------------------------
INDEXNOW_KEY=extremis2026indexnow

# ---------------------------------------------------------------------------
# AI News Automation
#
# IMPORTANT - AdSense compliance:
# Google's spam policies treat mass-produced, auto-published content with no
# human review as "scaled content abuse", and auto-deleting published articles
# signals low value. All three jobs below therefore default to OFF.
#
# Leave these disabled until every generated article is reviewed and edited by
# a human before it goes live, and until each article cites a real source.
# ---------------------------------------------------------------------------
AI_NEWS_GENERATE_ENABLED=false
AI_NEWS_UPDATE_ENABLED=false
AI_NEWS_DELETE_ENABLED=false

AI_NEWS_API_ENDPOINT=
AI_NEWS_API_KEY=
AI_NEWS_MODEL=
AI_NEWS_TEMPERATURE=0.7

AI_NEWS_GENERATE_SCHEDULE=daily
AI_NEWS_GENERATE_COUNT=1
AI_NEWS_GENERATE_LANG=en

AI_NEWS_UPDATE_SCHEDULE="0 */6 * * *"
AI_NEWS_UPDATE_AGE_HOURS=24
AI_NEWS_UPDATE_LIMIT=2

AI_NEWS_DELETE_SCHEDULE="0 3 * * *"
AI_NEWS_DELETE_AFTER_DAYS=30
AI_NEWS_DELETE_MIN_VIEWS=50
AI_NEWS_DELETE_KEEP_MAX=500
AI_NEWS_DELETE_CLEANUP_IMAGES=true

VITE_APP_NAME="${APP_NAME}"
